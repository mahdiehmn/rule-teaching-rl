# Copy this file to .env and fill in the values. .env is gitignored
# so secrets never get committed.

# Required for the LLM / VLM teacher (teachers/minigrid/llm.py).
OPENAI_API_KEY=

# Optional. Only needed if you log runs to Weights & Biases.
# Leave blank to log locally with TensorBoard instead.
WANDB_API_KEY=
